#include <behaviors/rgbled_widget.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bluetooth {
            bindings = <&mo 3>;
            key-positions = <41 36>;
        };

        bt2 {
            bindings = <&mo 3>;
            key-positions = <48 53>;
        };

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <38 39>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <39 40>;
        };

        ctrlAltTab {
            bindings = <&kp LC(LA(TAB))>;
            key-positions = <37 39>;
        };

        del {
            bindings = <&kp DELETE>;
            key-positions = <42 43>;
        };

        rBracket {
            bindings = <&as RIGHT_BRACKET>;
            key-positions = <18 19>;
        };

        lBracket {
            bindings = <&as LEFT_BRACKET>;
            key-positions = <16 17>;
        };

        backtickTilde {
            bindings = <&as GRAVE>;
            key-positions = <12 13>;
        };

        oneHand {
            bindings = <&tog 6>;
            key-positions = <5 4 3 2>;
        };
    };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47>;
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41>;
            hold-trigger-on-release;
        };

        layer_sticky: layer_sticky {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_STICKY";
            bindings = <&mo>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        holdTap: holdTap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        hold_AT: hold_AT {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_AT";
            bindings = <&kp>, <&altTab>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        as_ht: auto_shift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTO_SHIFT_HOLD_TAP";
            bindings = <&shift>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };

        fz_left: fz_left {
            compatible = "zmk,behavior-hold-tap";
            label = "FZ_LEFT";
            bindings = <&kp>, <&fzLeft>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        fz_right: fz_right {
            compatible = "zmk,behavior-hold-tap";
            label = "FZ_RIGHT";
            bindings = <&kp>, <&fzRight>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        ac_browser: ac_browser {
            compatible = "zmk,behavior-tap-dance";
            label = "AC_BROWSER";
            #binding-cells = <0>;
            bindings =
                <&holdTap LA(LS(LC(V))) LS(LA(LC(Q)))>,
                <&kp LS(LA(LC(X)))>;
        };

        ac_VMs: ac_VMs {
            compatible = "zmk,behavior-tap-dance";
            label = "AC_VMS";
            #binding-cells = <0>;
            bindings = <&kp LS(LA(LC(W)))>, <&kp LS(LA(LC(I)))>;
        };

        burp_rep: burp_rep {
            compatible = "zmk,behavior-tap-dance";
            label = "BURP_REP";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(R))>, <&kp LC(R)>;
        };

        burp_proxy: burp_proxy {
            compatible = "zmk,behavior-tap-dance";
            label = "BURP_PROXY";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(P))>, <&kp LC(T)>;
        };

        burp_intruder: burp_intruder {
            compatible = "zmk,behavior-tap-dance";
            label = "BURP_INTRUDER";
            #binding-cells = <0>;
            bindings = <&holdTap LC(P) LS(LC(I))>, <&kp LC(I)>;
        };

        burp_org: burp_org {
            compatible = "zmk,behavior-tap-dance";
            label = "BURP_ORG";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(O))>, <&kp LC(O)>;
        };

        burp_send: burp_send {
            compatible = "zmk,behavior-tap-dance";
            label = "BURP_SEND";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>, <&kp LS(LC(SPACE))>;
        };

        burp_dash: burp_dash {
            compatible = "zmk,behavior-tap-dance";
            label = "BURP_DASH";
            #binding-cells = <0>;
            bindings = <&holdTap LS(LC(NUMBER_9)) LC(LS(D))>, <&kp LS(LC(T))>;
        };

        burp_fwd: burp_fwd {
            compatible = "zmk,behavior-tap-dance";
            label = "BURP_FWD";
            #binding-cells = <0>;
            bindings = <&kp LC(F)>, <&kp LS(LC(F))>;
        };

        burp_notes_htmlE: burp_notes_htmlE {
            compatible = "zmk,behavior-tap-dance";
            label = "BURP_NOTES_HTMLE";
            #binding-cells = <0>;
            bindings = <&kp LC(LA(N))>, <&kp LC(LA(H))>;
        };
    };

    macros {
        altTab: altTab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_ALT &kp TAB &kt LEFT_ALT>;
            label = "ALTTAB";
            wait-ms = <200>;
        };

        pw: pw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp N3 &kp A &kp Q &kp H &kp Q &kp C &kp Y &kp B &kp N0 &kp DOT &kp N0>;
            label = "PW";
        };

        shift: new_macro {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LEFT_SHIFT>;

            label = "NEW_MACRO";
        };

        as: as {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;

            label = "AS";
        };

        fzLeft: fzLeft {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_GUI &kp LEFT &kt LEFT_GUI>;
            label = "FZLEFT";
            tap-ms = <100>;
        };

        fzRight: fzRight {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_GUI &kp RIGHT &kt LEFT_GUI>;
            label = "FZRIGHT";
            tap-ms = <100>;
        };

        fzUp: fzUp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_GUI &kp UP_ARROW &kt LEFT_GUI>;
            label = "FZUP";
            tap-ms = <100>;
        };

        fzDown: fzDown {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_GUI &kp DOWN &kt LEFT_GUI>;
            label = "FZDOWN";
            tap-ms = <100>;
        };

        img: img {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp RCLK &kp I>;
            label = "IMG";
            tap-ms = <200>;
        };

        close: close {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_ALT &kp F4 &kt LEFT_ALT>;
            label = "CLOSE";
            tap-ms = <200>;
        };

        ptm_codeBlock: ptm_codeBlock {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp GRAVE &kp GRAVE &kp ENTER &kp ENTER &kp GRAVE &kp GRAVE &kp GRAVE &kp UP_ARROW>;
            label = "PTM_CODEBLOCK";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  ESC |  1  |  2  |  3  |  4  |  5  |   |  6  |  7   |  8  |  9  |  0  |  ?   |
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESCAPE              &as N1           &as N2           &as N3               &as N4                      &as N5         &as N6         &as N7              &as N8        &as N9            &as N0               &as MINUS
&kp TAB                 &kp Q            &kp W            &kp E                &kp R                       &kp T          &kp Y          &kp U               &kp I         &kp O             &kp P                &as EQUAL
&caps_word              &hml LEFT_GUI A  &hml LEFT_ALT S  &hml LEFT_CONTROL D  &hml LEFT_SHIFT F           &kp G          &kp H          &hmr RIGHT_SHIFT J  &hmr RCTRL K  &hmr RIGHT_ALT L  &hmr RIGHT_GUI SEMI  &as SQT
&hold_AT PRINTSCREEN 0  &kp Z            &kp X            &kp C                &kp V                       &kp B          &kp N          &kp M               &as COMMA     &as DOT           &as SLASH            &as BSLH
                                                          &lt 5 LG(LS(D))      &layer_sticky 4 LEFT_SHIFT  &lt 2 ENTER    &kp BACKSPACE  &lt 1 SPACE         &lt 3 LC(M)
            >;
        };

        navigation {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  F1 |  F2 |  F3 |  F4 |  F5 |   |  F6 |  F7 |  F8 |  F9 | F10 | BKSP |
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans       &trans        &trans         &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp HOME     &kp UP_ARROW  &kp END        &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp LEFT     &kp DOWN      &kp RIGHT      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp PAGE_UP  &trans        &kp PAGE_DOWN  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans       &trans
            >;
        };

        fz_media_browser {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans        &trans         &trans                       &trans                             &trans                         &trans    &trans  &trans             &trans            &trans           &trans  &trans
&trans        &trans         &pw                          &fzUp                              &trans                         &trans    &trans  &kp C_VOLUME_DOWN  &kp C_MUTE        &kp C_VOLUME_UP  &trans  &trans
&trans        &trans         &fz_left LA(LC(LG(LEFT))) 0  &fzDown                            &fz_right LA(LC(LG(RIGHT))) 0  &trans    &trans  &kp C_PREV         &kp C_PLAY_PAUSE  &kp C_NEXT       &trans  &trans
&kp LA(LEFT)  &kp LA(RIGHT)  &trans                       &holdTap LC(NUMBER_1) LC(PAGE_UP)  &holdTap LC(N9) LC(PAGE_DOWN)  &trans    &trans  &trans             &trans            &trans           &trans  &trans
                                                          &trans                             &trans                         &trans    &trans  &trans             &trans
            >;
        };

        bluetooth {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans  &bt BT_CLR    &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans  &bt BT_CLR    &trans  &trans  &trans  &trans  &trans  &trans
&ind_bat      &ind_con      &trans        &trans        &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans
                                          &trans        &trans  &trans        &trans  &trans  &trans
            >;
        };

        burp_appChange {
            bindings = <
&trans             &trans          &trans         &trans       &trans      &trans         &close         &trans             &trans             &trans                                &trans             &trans
&trans             &trans          &trans         &trans       &trans      &trans         &trans         &trans             &kp LC(LA(LS(G)))  &trans                                &trans             &trans
&burp_dash         &burp_intruder  &burp_org      &burp_proxy  &burp_rep   &kp LS(F13)    &ac_VMs        &kp LA(LS(LC(C)))  &kp LA(LC(LS(B)))  &kp LA(LS(LC(T)))                     &kp LA(LS(LC(Z)))  &kp LA(LC(LS(E)))
&burp_notes_htmlE  &kp LS(LC(S))   &kp LC(LS(L))  &burp_fwd    &burp_send  &trans         &kp LS(LC(A))  &ac_browser        &kp LS(LC(LA(S)))  &holdTap LS(LA(LC(O))) LS(LA(LC(P)))  &kp LA(LS(LC(V)))  &kp LA(LS(LC(F)))
                                                  &trans       &trans      &trans         &trans         &trans             &trans
            >;
        };

        platform_mouse {
            bindings = <
&trans  &trans                &trans         &trans         &trans         &trans            &trans  &trans          &mkp MCLK       &trans           &trans  &trans
&trans  &kp LC(F21)           &trans         &trans         &trans         &trans            &trans  &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &trans  &trans
&trans  &kp LS(LC(NUMBER_1))  &kp LS(LA(R))  &kp LS(LA(T))  &kp LS(LA(N))  &ptm_codeBlock    &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &trans
&trans  &kp LC(LS(NUMBER_2))  &trans         &trans         &kp LC(LS(K))  &trans            &trans  &msc SCRL_DOWN  &msc SCRL_UP    &trans           &trans  &trans
                                             &trans         &trans         &trans            &trans  &trans          &trans
            >;
        };

        oneHand {
            bindings = <
&trans  &trans  &trans    &trans                             &trans                               &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &kp UP_ARROW                       &trans                               &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LEFT  &kp DOWN                           &kp RIGHT                            &img      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &holdTap LC(NUMBER_1) LC(PAGE_UP)  &holdTap LC(NUMBER_9) LC(PAGE_DOWN)  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                          &trans                             &trans                               &trans    &trans  &trans  &trans
            >;
        };
    };
};
